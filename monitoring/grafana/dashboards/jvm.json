{
  "uid": "bench-jvm",
  "title": "Benchmark REST - Ressources JVM",
  "tags": ["benchmark", "jvm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "variante",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(up{job=~\"variant-.*\"}, variant)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU processus (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"variant-.*\", variant=~\"$variante\"}[1m]) * 100",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Heap utilise (Mo)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (jvm_memory_used_bytes{area=\"heap\", job=~\"variant-.*\", variant=~\"$variante\"}) / 1024 / 1024",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Temps GC par seconde (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(jvm_gc_pause_seconds_sum{job=~\"variant-.*\", variant=~\"$variante\"}[1m])) * 1000",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Threads actifs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads{job=~\"variant-.*\", variant=~\"$variante\"}",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Pool Hikari (actives / max)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=~\"variant-.*\", variant=~\"$variante\"}",
          "legendFormat": "{{variant}} actives"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_max{job=~\"variant-.*\", variant=~\"$variante\"}",
          "legendFormat": "{{variant}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Debit HTTP (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(http_server_requests_seconds_count{job=~\"variant-.*\", variant=~\"$variante\"}[1m]))",
          "legendFormat": "{{variant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      }
    }
  ]
}
